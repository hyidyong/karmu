# Browser key: restrict to Maps JavaScript API and approved HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: restrict to Routes API and keep outside client bundles.
GOOGLE_ROUTES_API_KEY=
# Optional Claude-compatible gateway base URL.
ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
